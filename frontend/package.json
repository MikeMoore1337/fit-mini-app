{
  "name": "fit-mini-app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "e2e:ci": "playwright test",
    "e2e:migrated-stack": "playwright test --config=playwright.migrated-stack.config.ts",
    "e2e:cross-browser": "playwright test --config=playwright.cross-browser.config.ts",
    "e2e:tma-smoke": "npm run build && playwright test tma-smoke.spec.ts demo-mode.spec.ts",
    "perf:check": "node ../scripts/check_frontend_performance.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && vite build",
    "api:schema": "node ../scripts/run_python.mjs ../scripts/export_openapi.py openapi.json",
    "api:types": "npm run api:schema && openapi-typescript openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
