[Unit]
Description=Task 129 bounded Hermes editorial worker outbox drain
Requires=hermes-discovery.service
After=hermes-discovery.service

[Service]
Type=oneshot
User=hermes
Group=hermes
UMask=0077
EnvironmentFile=/etc/hermes/worker.env
Environment=HERMES_DISCOVERY_DEFINITIONS=/etc/hermes/source-definitions.json
Environment=HERMES_DISCOVERY_DEFINITIONS_SHA256=@SOURCE_DEFINITIONS_SHA256@
Environment=HERMES_DISCOVERY_STATE_DIR=/var/lib/hermes
Environment=HERMES_DISCOVERY_OUTBOX_DIR=/var/lib/hermes/outbox
Environment=HERMES_WORKER_TIMEOUT_SECONDS=120
Environment=HERMES_WORKER_MAX_JOBS=1
ExecStart=/usr/bin/python3 /opt/hermes/hermes_worker_drain.py --once
TimeoutStartSec=360s
RuntimeMaxSec=360s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/hermes/source-definitions.json
ReadWritePaths=/var/lib/hermes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=64
MemoryMax=768M
CPUQuota=75%
